OLD_DIR="$(pwd)"
DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd $DIR

# Rebuild from scratch so no stale files from previous deploys remain in the archive
rm -f src.zip
# Code + config (includes redis.json, generated by Terraform) + seed data.
# state/log.ndjson isn't included: each node generates its own.
zip src.zip *.js *.json state/accounts.json state/rates.json -1

cd $OLD_DIR
